# All new website settings live here. The Bot still reads the root .env.
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=3100
WEB_PUBLIC_URL=http://127.0.0.1:3100
# Leave blank to inherit the existing Bot music_server connection.
# An override must identify the same library as REMOTE_MUSIC_API_URL.
WEB_MUSIC_API_URL=
WEB_MUSIC_API_TOKEN=
WEB_AUTH_DB_PATH=./data/auth.sqlite
# Optional public URL of music_server's existing /admin page.
WEB_UPLOAD_URL=
# Website-specific resource limits (optional).
WEB_API_TIMEOUT_MS=8000
WEB_MEDIA_IDLE_TIMEOUT_MS=30000
WEB_MEDIA_MAX_CONNECTIONS=16
WEB_MEDIA_MAX_PER_USER=3
WEB_SSE_MAX_CONNECTIONS=64
WEB_SSE_MAX_PER_USER=3
WEB_SSE_RECHECK_MS=2000
WEB_COMMAND_MAX_PENDING_PER_GUILD=8
WEB_COMMAND_TIMEOUT_MS=30000
# Optional external supervisor. Website-only failures do not restart the Bot.
WEB_SUPERVISOR_STALL_MS=20000
WEB_SUPERVISOR_STARTUP_GRACE_MS=60000
WEB_SUPERVISOR_RESTART_DELAY_MS=2000
WEB_SUPERVISOR_KILL_GRACE_MS=5000
WEB_SUPERVISOR_MAX_RESTARTS_PER_HOUR=5
