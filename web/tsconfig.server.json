{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "declaration": true,
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "contracts/**/*.ts"],
  "exclude": ["node_modules", "dist", "client", "tests"]
}
