{
  "name": "cirno-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "allowScripts": {
    "sqlite3@5.1.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/server/entry.js",
    "start:supervised": "node dist/server/supervised-entry.js",
    "auth": "node dist/server/auth/cli.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:browser": "node scripts/test.mjs browser"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.12.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "playwright": "^1.58.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
